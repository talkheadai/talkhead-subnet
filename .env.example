# Chi Subnet Configuration
# Copy this file to .env and update the values

# Network Configuration
NETWORK=finney              # finney (mainnet), test (testnet), or local
NETUID=108                  # Your subnet's netuid
IMAGE_REF=your-repo@sha256:replace-me
SUBNET_API_URL=https://subnet.talkhead.ai
EXECUTOR_API_URL=http://localhost:8000

# Wallet Configuration
WALLET_NAME=default     # Name of your wallet
HOTKEY_NAME=default     # Name of your hotkey

# Logging
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
